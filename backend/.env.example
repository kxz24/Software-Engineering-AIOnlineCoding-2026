# 为这五项分别生成一个值，每项执行一次 openssl rand -hex 32。
DJANGO_SECRET_KEY=
JWT_SECRET=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=

# 填服务器域名或地址时，省略协议和端口，多个值以逗号分隔。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
# 经宿主机的 HTTPS 反向代理对外服务时设为 1。
DJANGO_SECURE_COOKIES=0

# 使用真实助教时设置 AGENT_PROVIDER=deepseek 并填写密钥。
AGENT_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat
# 受限模式回复审查；默认复用上面的网关与密钥
AGENT_GUARD_ENABLED=1
AGENT_GUARD_MODEL=Qwen3.8-Flash
# 学习过程实验分支的报告模型；缺省复用审查模型
# AGENT_REPORT_MODEL=Qwen3.8-Flash
# 首轮解答保留模型默认思考；以下阶段默认关闭思考以缩短等待时间
# AGENT_GUARD_DISABLE_THINKING=1
# AGENT_RETRY_DISABLE_THINKING=1
# AGENT_REPORT_DISABLE_THINKING=1
# 可选：单次输出上限 / 工具轮次 / 历史消息条数 / 请求超时（秒）
# 输出上限（含思考 token；网关把 reasoning 计入 max_tokens，过低会截断正文）
# AGENT_MAX_OUTPUT_TOKENS=4096
# AGENT_MAX_TOOL_ROUNDS=6
# AGENT_HISTORY_MESSAGES=40
# AGENT_REQUEST_TIMEOUT=180

