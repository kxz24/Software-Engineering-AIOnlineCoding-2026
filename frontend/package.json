{
  "name": "aicoding-exam-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^1.4.0",
    "normalize.css": "^8.0.1",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-redux": "^7.2.1",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "3.4.3",
    "typescript": "^3.9.7"
  },
  "scripts": {
    "start": "run-script-os",
    "start:win32": "set NODE_OPTIONS=--openssl-legacy-provider && react-scripts start",
    "start:linux:darwin": "NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "start:default": "set NODE_OPTIONS=--openssl-legacy-provider && react-scripts start",
    "startwithoutbrowser": "run-script-os",
    "startwithoutbrowser:win32": "set NODE_OPTIONS=--openssl-legacy-provider && set BROWSER=none && set PORT=3001 && react-scripts start --no-open -y --no-hot",
    "startwithoutbrowser:linux:darwin": "NODE_OPTIONS=--openssl-legacy-provider BROWSER=none PORT=3001 react-scripts start --no-open -y --no-hot",
    "startwithoutbrowser:default": "set NODE_OPTIONS=--openssl-legacy-provider && set BROWSER=none && set PORT=3001 && react-scripts start --no-open -y --no-hot",
    "build": "run-script-os",
    "build:win32": "set NODE_OPTIONS=--openssl-legacy-provider && react-scripts build",
    "build:linux:darwin": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "build:default": "set NODE_OPTIONS=--openssl-legacy-provider && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "proxy": "http://127.0.0.1:8000",
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/jest": "^24.9.1",
    "@types/react": "^16.9.0",
    "@types/react-dom": "^16.9.8",
    "@types/react-redux": "^7.1.9",
    "@types/react-router": "^5.1.8",
    "@types/react-router-dom": "^5.1.5",
    "run-script-os": "^1.1.6"
  }
}
